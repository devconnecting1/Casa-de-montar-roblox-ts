{
	"name": "block-house-demo",
	"version": "1.0.0",
	"description": "Casa demonstração de engenharia em blocos de montar — roblox-ts (TypeScript) compilando para Luau/Roblox",
	"private": true,
	"scripts": {
		"build": "rbxtsc",
		"watch": "rbxtsc -w",
		"clean": "rimraf out",
		"preview": "npx http-server ./preview -p 8080 -o",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@rbxts/services": "^1.6.0"
	},
	"devDependencies": {
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.956",
		"http-server": "^14.1.1",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"roblox-ts": "^3.0.0",
		"typescript": "5.5.3"
	}
}
